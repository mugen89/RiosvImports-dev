<Project>

  <!--
    Номерът на изданието — едно място за всички проекти.

    Тук стои изданието, което се готви. tools\release.ps1 го подменя с
    -p:Version при всяко издание, а програмата го показва в заглавната лента,
    в „Настройки → Обновяване“ и в данните за поддръжка. Инсталираната програма
    чете номера от инсталатора; този е за сглобената тук.
  -->
  <PropertyGroup>
    <Version>1.3.1</Version>
    <Product>RIOSV Imports</Product>
    <Copyright>© 2026. Всички права запазени.</Copyright>
  </PropertyGroup>

</Project>
